{
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "a11y": "off"
    }
  },
  "overrides": [
    {
      "includes": ["src/connection/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/state/**", "**/ui/**", "**/session.js"],
                    "message": "connection/ is the bottom layer: depend only on @getpaseo/* and node built-ins."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/state/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/ui/**", "**/session.js"],
                    "message": "state/ must not depend on ui/ or the session root; move shared types into state/ or connection/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
